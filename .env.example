# 競馬予測システム v3.0 環境設定

# Cloudflare設定（Claude直接実行のため、Claude APIキーは不要）
# 本番環境
CLOUDFLARE_API_URL=https://api.keiba-prediction.com
# ステージング環境
# CLOUDFLARE_API_URL=https://staging-api.keiba-prediction.com

CF_SYNC_TOKEN=your-cloudflare-sync-token-here

# 環境設定 (production/staging)
ENVIRONMENT=production

# JRDB設定（オプション - 未設定時はデモモードで動作）
JRDB_USERNAME=your-jrdb-username
JRDB_PASSWORD=your-jrdb-password

# システム設定
TARGET_RETURN_RATE=0.80
CYCLE_INTERVAL_MINUTES=30

# 開発用設定
NODE_ENV=production
VITE_API_URL=https://api.keiba-prediction.com